# Security headers (no impact on rankings, but a quality signal).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Angular's production build fingerprints every JS/CSS file
# (`outputHashing: "all"`), so they can be cached forever.
# HTML keeps Netlify's default revalidation.
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable
